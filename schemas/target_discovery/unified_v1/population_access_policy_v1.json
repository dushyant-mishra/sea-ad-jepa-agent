{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "POPULATION_ACCESS_POLICY_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_role",
    "policy_schema",
    "assignment_basis_sha",
    "fold_count",
    "crossfit_folds",
    "allowed_outcome_partitions",
    "protected_partitions"
  ],
  "properties": {
    "object_role": {"const": "ACCESS_POLICY"},
    "policy_schema": {"const": "POPULATION_ACCESS_POLICY_V1"},
    "assignment_basis_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fold_count": {"const": 5},
    "crossfit_folds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fold_index", "train_donors", "held_out_donors"],
        "properties": {
          "fold_index": {"type": "integer", "minimum": 0, "maximum": 4},
          "train_donors": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "held_out_donors": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "allowed_outcome_partitions": {
      "type": "array",
      "const": ["reader_fit"]
    },
    "protected_partitions": {
      "type": "array",
      "const": ["reader_validation", "reader_oracle"]
    }
  }
}
