{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PRODUCER_ACCESS_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_schema", "producer_id", "access_policy_sha", "access_ledger_sha", "observed_access"],
  "properties": {
    "receipt_schema": {"const": "PRODUCER_ACCESS_RECEIPT_V1"},
    "producer_id": {"type": "string", "minLength": 1},
    "access_policy_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "access_ledger_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_access": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["partition", "access_class", "fold_index", "phase", "donor_ids"],
        "properties": {
          "partition": {"enum": ["reader_fit", "reader_validation", "reader_oracle"]},
          "access_class": {
            "enum": ["METADATA", "PARTITION_IDENTITY", "SUPPORT_ONLY_SUMMARY", "BIOLOGICAL_VALUES", "CALIBRATION_STATISTICS"]
          },
          "fold_index": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
          "phase": {"enum": ["TRAIN", "EVAL", "CUSTODY"]},
          "donor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "numeric_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
