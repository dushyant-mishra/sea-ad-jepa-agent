{
  "schema": "V69_REGULATORY_PROGRAM_EVIDENCE_RECORD_SCHEMA_V1",
  "required": [
    "program_id",
    "source_id",
    "evidence_class",
    "population",
    "feature_support",
    "direct_measurement",
    "independence_axes",
    "exposure_state",
    "effect_summary",
    "uncertainty_summary",
    "limitations",
    "measured_vs_predicted"
  ],
  "enums": {
    "evidence_class": [
      "PRIMARY_CORRESPONDENCE",
      "REGULATORY_ARCHITECTURE",
      "SAME_NUCLEUS_SUPPORT",
      "SEPARATE_NUCLEUS_REPLICATION",
      "CAUSAL_SUPPORT",
      "INTACT_TISSUE_SUPPORT",
      "TRANSPORT_SUPPORT"
    ],
    "measured_vs_predicted": [
      "DIRECT_MEASUREMENT",
      "DERIVED_FROM_DIRECT_MEASUREMENT",
      "RNA_PREDICTED",
      "STRUCTURAL_ONLY",
      "NOT_AVAILABLE"
    ],
    "exposure_state": [
      "UNOPENED",
      "STRUCTURAL",
      "INSPECTED",
      "DEVELOPMENT",
      "HISTORICALLY_EXPOSED",
      "UNKNOWN",
      "PROTECTED"
    ]
  },
  "semantic_rules": [
    "effect_summary may be null/empty for structural-only records but must not be fabricated",
    "structural missingness is not zero effect",
    "population must identify the biological unit used for inference",
    "independence_axes must explicitly record unit, assay, cohort/lab, feature-definition, technical-environment, causal-direction, tissue-context and outcome-exposure independence where known",
    "a program/source pair is represented separately even when another source measures the same program",
    "source-specific statistics are never numerically pooled by this schema",
    "RNA_PREDICTED records require prior recoverability qualification and cannot masquerade as direct measurement"
  ],
  "example_blank_record": {
    "program_id": "PROGRAM_VERSIONED_ID",
    "source_id": "SOURCE_ID",
    "evidence_class": "PRIMARY_CORRESPONDENCE",
    "population": {
      "unit": "donor",
      "n_units": null,
      "lineage": null,
      "region": null
    },
    "feature_support": {
      "genes_measured": null,
      "regions_measured": null,
      "support_fraction": null,
      "missing_reason": null
    },
    "direct_measurement": {
      "rna": null,
      "atac": null,
      "perturbation": null,
      "spatial": null
    },
    "independence_axes": {
      "unit": null,
      "assay": null,
      "cohort_lab": null,
      "feature_definition": null,
      "technical_environment": null,
      "causal_direction": null,
      "tissue_context": null,
      "outcome_exposure": null
    },
    "exposure_state": "UNKNOWN",
    "effect_summary": null,
    "uncertainty_summary": null,
    "limitations": [],
    "measured_vs_predicted": "NOT_AVAILABLE"
  }
}
