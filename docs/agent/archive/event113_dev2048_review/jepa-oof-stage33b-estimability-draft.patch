+def _finite_pairs(y_true: np.ndarray, y_pred: np.ndarray) -> tuple[np.ndarray, np.ndarray]:
+    truth = np.asarray(y_true, dtype=float)
+    prediction = np.asarray(y_pred, dtype=float)
+    if truth.ndim != 1 or truth.shape != prediction.shape:
+        raise ValueError("correlation inputs must be aligned one-dimensional arrays")
