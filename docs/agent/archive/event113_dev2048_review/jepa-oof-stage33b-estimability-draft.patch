+"""Stage 33B score/gate regression from inert predictions; no runner imports."""
+import ast
+from pathlib import Path
+from typing import Any
+import unittest
+
+import numpy as np
+import pandas as pd
+from sea_ad_jepa.eval.oof_metrics import regression_metrics
+
+
+def load_scoring_surface():
+    path = Path(__file__).resolve().parents[1] / 'scripts/run_stage33b_external_pretrained_jepa_v1.py'
+    module = ast.parse(path.read_text(encoding='utf-8'))
+    names = {'REF27', 'REF31', 'EXT_NG', 'EXT_ID', 'EXT_REAL', 'EXT_WEAK',
+             'EXT_STRICT', 'EXTERNAL_CONDITIONS'}
+    allowed = [node for node in module.body if (
+        isinstance(node, ast.Assign) and len(node.targets) == 1
+        and isinstance(node.targets[0], ast.Name) and node.targets[0].id in names
+    ) or (
+        isinstance(node, ast.FunctionDef) and node.name in {'compute_metrics', 'audits_and_passfail'}
+    )]
+    env = dict(Any=Any, np=np, pd=pd, regression_metrics=regression_metrics)
+    exec(compile(ast.Module(body=allowed, type_ignores=[]), str(path), 'exec'), env)
+    return env
+
+
+class Stage33BEstimabilityTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.scope = load_scoring_surface()
+
+    def score(self, change=None, empty=False):
+        s = self.scope
+        targets = ['AT8', '6e10/A_beta', 'GFAP', 'Iba1', 'NeuN']
+        rows = []
+        for condition in [*s['EXTERNAL_CONDITIONS'], s['REF27'], s['REF31']]:
+            for name in targets:
+                # Zero reference and non-graph, positive real graph; keep one
+                # genuinely zero real-graph target in the complete control.
+                prediction = ([-1, 0, 1] if condition == s['EXT_REAL'] and name != 'NeuN'
+                              else [1, -2, 1])
+                for i, (y, p) in enumerate(zip([-1, 0, 1], prediction)):
+                    rows.append(dict(condition=condition, target=name, target_key=name,
+                                     target_alias=name, donor_id=str(i), y_true=y, y_pred=p))
+        oof = pd.DataFrame(rows)
+        if change:
+            oof = change(oof)
+        if empty:
+            oof = oof.iloc[:0]
+        cfg = dict(required_targets=targets, stage27c_reference_mean=0.0,
+                   stage31_best_reference_mean=0.0, minimum_success_threshold=0.5,
+                   max_target_drop_vs_stage27c_reference=-0.02)
+        target, mean = s['compute_metrics'](oof, targets)
+        _, graph, result = s['audits_and_passfail'](
+            cfg, oof, target, mean, dict(stage32c_ready=True, matrix_path_exists=True))
