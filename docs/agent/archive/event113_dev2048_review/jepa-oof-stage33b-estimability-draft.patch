+++ b/tests/test_oof_correlation_estimability.py
@@ -0,0 +1,55 @@
+"""Numeric OOF fixtures only; no model, training, or external data."""
+import json
+import math
+import unittest
+
+import pandas as pd
+
+from sea_ad_jepa.eval.oof_metrics import donor_bootstrap_ci, regression_metrics, safe_corr
+
+
+class OofCorrelationEstimabilityTests(unittest.TestCase):
+    def test_measured_zero_and_undefined_survive_json(self):
+        for method in ('pearson', 'spearman'):
+            key = f'pooled_oof_{method}'
+            zero = regression_metrics([-1, 0, 1], [1, -2, 1])
+            missing = regression_metrics([-1, 0, 1], [1, 1, 1])
+            for result in (zero, missing):
+                fields = {k: v for k, v in result.items() if k.startswith(key)}
+                self.assertEqual(json.loads(json.dumps(fields, allow_nan=False)), fields)
+            self.assertAlmostEqual(zero[key], 0.0, places=14)
+            self.assertEqual(zero[key + '_status'], 'ESTIMATED')
+            self.assertIsNone(missing[key])
+            self.assertEqual(missing[key + '_status'], 'NOT_ESTIMABLE')
+            self.assertEqual(missing[key + '_reason'], 'CONSTANT_PREDICTION')
+            self.assertEqual(missing[key + '_n_valid_pairs'], 3)
+
+    def test_pair_filtering_constant_target_and_scalar_adapter(self):
+        self.assertTrue(math.isnan(safe_corr([1, 2, 3], [4, 4, 4])))
+        low = regression_metrics([1, 2, 3], [3, float('inf'), 2])
+        self.assertEqual(low['pooled_oof_spearman_reason'], 'INSUFFICIENT_VALID_PAIRS')
+        self.assertEqual(low['pooled_oof_spearman_n_valid_pairs'], 2)
+        const = regression_metrics([1, 1, 1], [1, 2, 3])
+        self.assertEqual(const['pooled_oof_spearman_reason'], 'CONSTANT_TARGET')
+
+    def test_bootstrap_reports_complete_partial_and_unestimable(self):
+        def run(donors, pred):
+            data = pd.DataFrame({'group': ['a'] * 3, 'donor_id': donors,
+                                 'y_true': [1, 2, 3], 'y_pred': pred})
+            return donor_bootstrap_ci(data, ['group'], n_resamples=40).iloc[0]
+        complete = run(['a', 'a', 'a'], [1, 2, 3])
+        self.assertEqual(complete.uncertainty_status, 'complete')
+        self.assertAlmostEqual(complete.spearman_ci_median, 1.0)
+        partial = run(['a', 'b', 'c'], [1, 2, 3])
+        self.assertEqual(partial.uncertainty_status, 'incomplete')
+        self.assertGreater(partial.n_bootstrap_estimable, 0)
+        self.assertGreater(partial.n_bootstrap_not_estimable, 0)
+        self.assertTrue(pd.isna(partial.spearman_ci_median))
+        none = run(['a', 'b', 'c'], [1, 1, 1])
+        self.assertEqual(none.uncertainty_status, 'not_estimable')
+        self.assertEqual(none.n_bootstrap_estimable, 0)
+        self.assertTrue(pd.isna(none.spearman_ci_low))
+
+
+if __name__ == '__main__':
+    unittest.main()
