      "    && rm -f \\",
      "         /tmp/mallet-train-topics-help.txt \\",
      "         /tmp/cbust-help.txt \\",
      "         /tmp/liftover-help.txt \\",
      "         /tmp/bigwig-average-over-bed-help.txt",
      "",
      "WORKDIR /workspace",
      "",
      "CMD [\"/bin/bash\"]"
    ]
