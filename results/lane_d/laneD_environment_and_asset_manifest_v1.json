      "      poetry-core==1.0.8 \\",
      "    && micromamba run -n base python -m pip install \\",
      "      --no-cache-dir \\",
      "      --no-deps \\",
      "      poetry==1.1.15 \\",
      "    && micromamba run -n base python -m pip install \\",
      "      --no-build-isolation \\",
      "      --no-cache-dir \\",
      "      /tmp/scenicplus \\",
      "    && micromamba run -n base python -m pip uninstall -y \\",
      "      poetry \\",
      "      poetry-core \\",
      "      hatchling \\",
      "    && rm -rf /tmp/scenicplus",
      "",
      "RUN micromamba run -n base python - <<'PY'",
      "import anndata",
      "import pybedtools",
      "import pycisTopic",
      "import pycistarget",
      "import pyscenic",
